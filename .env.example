# TCGI LMS configuration (see src/config.ts). Copy it to your secrets manager or a local .env. Never commit real values.
NODE_ENV=production
ENV_LABEL=staging
HOST=0.0.0.0
APP_PORT=3000
CONTENT_PORT=3001
APP_BASE_URL=https://lms-staging.example.org
# Must be a different origin from APP_BASE_URL (ADR-0002).
CONTENT_BASE_URL=https://content.lms-staging.example.org
# Application role: NOT the table owner, NOBYPASSRLS.
DATABASE_URL=postgres://lms_app:CHANGE_ME@db-host:5432/lms
# Owner role, used only by `cli migrate`.
MIGRATION_DATABASE_URL=postgres://lms_owner:CHANGE_ME@db-host:5432/lms
LAUNCH_TOKEN_SECRET=CHANGE_ME_at_least_32_random_characters
OUTBOUND_SIGNING_SECRET=CHANGE_ME_at_least_32_random_characters
OUTBOUND_SIGNING_KEY_ID=lms-outbound-1
# miniOrange sandbox OIDC client (DEC-06).
OIDC_ISSUER=https://CHANGE_ME.miniorange.example
OIDC_CLIENT_ID=CHANGE_ME
OIDC_CLIENT_SECRET=CHANGE_ME
OIDC_PROVIDER_LABEL=miniOrange (sandbox)
OIDC_ALLOW_INSECURE_HTTP=false
AUTH_ALLOW_SELF_REGISTRATION=false
SESSION_IDLE_MINUTES=60
SESSION_ABSOLUTE_HOURS=12
BLOB_DIR=var/blobs
# disabled | webhook  (HubSpot object mapping pending DEC-08)
HUBSPOT_MODE=disabled
# HUBSPOT_WEBHOOK_URL=https://approved-sandbox-receiver.example/events
OUTBOX_MAX_ATTEMPTS=8
RUN_WORKER=false
LOG_LEVEL=info
